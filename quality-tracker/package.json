{
  "name": "quality-files-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "نظام متابعة إنجاز ملفات الجودة لأقسام الكلية - وكالة الكلية للتطوير والجودة",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "tick": "tsx src/cli.ts tick",
    "preview": "tsx src/cli.ts preview",
    "inbox": "tsx src/cli.ts inbox",
    "excel:template": "tsx src/cli.ts excel-template",
    "excel:import": "tsx src/cli.ts excel-import",
    "excel:export": "tsx src/cli.ts excel-export",
    "test:channels": "tsx src/cli.ts test-channels",
    "test": "tsx --test test/engine.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "imapflow": "^1.0.190",
    "mailparser": "^3.7.4",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.9"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2"
  }
}
