# ============================================================
#  إعدادات نظام متابعة ملفات الجودة
#  انسخ هذا الملف إلى .env ثم عبّئ القيم
# ============================================================

# ---------- عام ----------
PORT=4000
TZ_NAME=Asia/Riyadh
# بيانات مدير النظام الافتراضي (تُستخدم مرة واحدة عند أول تشغيل لإنشاء الحساب - غيّرها بعد الدخول)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# مفتاح توقيع الجلسات (اختياري - يُولَّد تلقائياً ويُحفظ في data/.session-secret)
SESSION_SECRET=
# وضع التجربة: true = لا يتم إرسال أي رسالة فعلياً، تُسجَّل فقط في السجل
DRY_RUN=true

# ---------- البريد الإلكتروني (SMTP) ----------
# Office 365:  smtp.office365.com  / 587
# Gmail:       smtp.gmail.com      / 587  (يتطلب App Password)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=quality@college.edu.sa
SMTP_PASS=
MAIL_FROM_NAME=وكالة الكلية للتطوير والجودة
MAIL_FROM=quality@college.edu.sa
# بريد الوكيل (يُرسل له التقارير ويُضاف نسخة CC على الرسائل إذا فُعِّل ذلك في الإعدادات)
VICE_DEAN_EMAIL=vice.dean@college.edu.sa

# ---------- رصد التسليم من صندوق الوارد (IMAP) ----------
# Office 365: outlook.office365.com / 993   |  Gmail: imap.gmail.com / 993
IMAP_ENABLED=false
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=quality@college.edu.sa
IMAP_PASS=
IMAP_MAILBOX=INBOX
# كل كم دقيقة يتم فحص الصندوق
IMAP_POLL_MINUTES=15

# ---------- Microsoft Teams ----------
# الطريقة المعتمدة: رابط Workflow Webhook لكل قسم (يوضع في بيانات القسم داخل لوحة المتابعة)
# هذا الرابط العام يُستخدم لتقارير الوكيل/الوكالة
TEAMS_WEBHOOK_URL=

# ---------- WhatsApp ----------
# WHATSAPP_PROVIDER: none | meta | twilio
WHATSAPP_PROVIDER=none
# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# اسم قالب معتمد (اختياري) - إذا وُضع تُرسل الرسالة كقالب بمعامل واحد هو نص الرسالة
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar
# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
